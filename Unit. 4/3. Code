#include <iostream>
using namespace std;

// Define a node of the binary tree
class Node
{
public:
    int data;
    Node *left;
    Node *right;

    // Constructor
    Node(int value)
    {
        data = value;
        left = NULL;
        right = NULL;
    }
};

// Function to check full binary tree
bool isFullBinaryTree(Node *root)
{
    // If the node is empty
    if (root == NULL)
        return true;

    // If the node has no children
    if (root->left == NULL && root->right == NULL)
        return true;

    // If the node has two children
    if (root->left != NULL && root->right != NULL)
    {
        return isFullBinaryTree(root->left) &&
               isFullBinaryTree(root->right);
    }

    // If the node has only one child
    return false;
}

int main()
{
    // Create the root node
    Node *root = new Node(1);

    // Create the child nodes
    root->left = new Node(2);
    root->right = new Node(3);

    root->left->left = new Node(4);
    root->left->right = new Node(5);

    // Validate the binary tree
    if (isFullBinaryTree(root))
    {
        cout << "The tree is a Full Binary Tree.";
    }
    else
    {
        cout << "The tree is not a Full Binary Tree.";
    }

    return 0;
}
