#include <iostream>
#include <vector>
#include <queue>
using namespace std;

int main()
{
    int n, e, u, v, start;

    cout << "Enter number of delivery zones: ";
    cin >> n;

    vector<vector<int>> adj(n);

    cout << "Enter number of connecting roads: ";
    cin >> e;

    cout << "Enter roads (zone1 zone2):\n";

    for (int i = 0; i < e; i++)
    {
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    cout << "Enter starting delivery zone: ";
    cin >> start;

    vector<bool> visited(n, false);
    vector<int> level(n, -1);
    queue<int> q;

    visited[start] = true;
    level[start] = 0;
    q.push(start);

    cout << "\nBFS Traversal Order: ";

    while (!q.empty())
    {
        u = q.front();
        q.pop();

        cout << u << " ";

        for (int x : adj[u])
        {
            if (!visited[x])
            {
                visited[x] = true;
                level[x] = level[u] + 1;
                q.push(x);
            }
        }
    }

    cout << "\n\nDelivery Zone\tBFS Level\n";

    for (int i = 0; i < n; i++)
    {
        if (visited[i])
            cout << i << "\t\t" << level[i] << endl;
    }

    return 0;
}
